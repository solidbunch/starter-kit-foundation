# Do not edit .conf file, it will override by script.
# Edit .conf.template file to change settings
#
# Bootstrap project nginx config file

server_names_hash_bucket_size 128;

# Rate limiting zones (http context only — applied per-location in config/common.conf)
# req_limit / conn_limit are applied to /wp-login.php and /xmlrpc.php only.
# req_limit_static is intentionally defined but not applied to any location yet.
limit_req_zone  $binary_remote_addr zone=req_limit:10m rate=20r/s;
limit_conn_zone $server_name$binary_remote_addr zone=conn_limit:10m;
limit_req_zone  $binary_remote_addr zone=req_limit_static:10m rate=100r/s;

# Headers setup
include /etc/nginx/conf.d/config/partials/headers.conf;

# Gzip compression
include /etc/nginx/conf.d/config/partials/gzip.conf;

# Nginx logs
include /etc/nginx/conf.d/config/partials/logs.conf;

include /etc/nginx/conf.d/config/${APP_PROTOCOL}.conf;

# Return nothing for not defined domains
# ToDo add 443 port
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
