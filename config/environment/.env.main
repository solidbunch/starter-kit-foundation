####################
##    Main env    ##
########################################################################################################################
#
# In all environments, the following files are concatenated. The latter taking precedence over the former.
#
# .env.main                     contains common default values for the environment variables needed by the app
# .env.type.[environment_type]  committed environment-specific
# .env.secret                   uncommitted file with secrets
#
########################################################################################################################
#
# Result root file:
#
# .env                          uncommitted automatically concatenated file (main + environment-specific + secrets)
#
########################################################################################################################
#
# DO NOT DEFINE SECRETS IN COMMITTED FILES. USE .env.secret AND ./sh/env/.env.secret.template
#
# Do not edit the automatically concatenated root .env file. It will be overwritten every time the app run.
#
########################################################################################################################

# App info
APP_NAME=starter-kit
APP_TITLE="Starter Kit"

# Default environment type for run commands params
# local|dev|stage|prod
APP_DEFAULT_ENV_TYPE=local

# Default packages install and build mode
# dev|prod
APP_BUILD_MODE=dev

# Docker containers images
# use build: ./dockerfiles/service-name in docker-compose.yml file for building just local images
APP_DATABASE_IMAGE=ghcr.io/solidbunch/starter-kit-mariadb:11.5.2-noble
APP_PHP_IMAGE=ghcr.io/solidbunch/starter-kit-php:8.4-fpm-alpine3.24-r1
APP_NGINX_IMAGE=ghcr.io/solidbunch/starter-kit-nginx:1.29-alpine3.23
APP_CRON_IMAGE=ghcr.io/solidbunch/starter-kit-cron:1.5-alpine3.24
APP_COMPOSER_IMAGE=ghcr.io/solidbunch/starter-kit-composer:2.10-php8.4-alpine3.24-r1
APP_NODE_IMAGE=ghcr.io/solidbunch/starter-kit-node:18-alpine3.21
APP_CERTBOT_IMAGE=ghcr.io/solidbunch/starter-kit-certbot:2.11-alpine3.24
APP_IAC_IMAGE=ghcr.io/solidbunch/starter-kit-iac:1.1.1
APP_PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache
APP_MAILHOG_IMAGE=mailhog/mailhog:v1.0.1

# Server capacity
WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M

# Cron working with unix crond in cron container
WP_DISABLE_WP_CRON=1

# Disable file editor, plugins and themes installation, and updates
DISALLOW_FILE_EDIT=1
DISALLOW_FILE_MODS=1
AUTOMATIC_UPDATER_DISABLED=1

# Set default theme
WP_DEFAULT_THEME=starter-kit-theme

# Post revisions limit
WP_POST_REVISIONS=15

# Containers default user and group ID. Used if CURRENT_UID and CURRENT_GID not defined in Makefile. Fix Permission denied error
DEFAULT_GID=1000
DEFAULT_UID=1000
DEFAULT_USER=www-data

DEFAULT_PATH=/srv

# OIDC configuration for GitHub Actions AWS access
# ROLE_NAME: everyday provisioning role, used by every Provision/Deploy run — never has
# s3:CreateBucket/dynamodb:CreateTable permissions
ROLE_NAME="github-actions-role"
# BOOTSTRAP_ROLE_NAME: separate, narrowly-scoped role used ONLY by the one-time state-backend
# bootstrap workflow — the only role with s3:CreateBucket/dynamodb:CreateTable
BOOTSTRAP_ROLE_NAME="github-actions-bootstrap-role"
GITHUB_ORG="solidbunch"
GITHUB_REPO="starter-kit-foundation"

# OIDC configuration for GitLab CI/CD AWS access
# GITLAB_ROLE_NAME: everyday provisioning role, used by every Provision/Deploy run — never has
# s3:CreateBucket/dynamodb:CreateTable permissions
GITLAB_ROLE_NAME="gitlab-ci-role"
# GITLAB_BOOTSTRAP_ROLE_NAME: separate, narrowly-scoped role used ONLY by the one-time
# state-backend bootstrap workflow — the only role with s3:CreateBucket/dynamodb:CreateTable
GITLAB_BOOTSTRAP_ROLE_NAME="gitlab-ci-bootstrap-role"
# GITLAB_HOST: OIDC issuer host — default gitlab.com; override for self-managed/Dedicated GitLab
GITLAB_HOST="gitlab.com"
# GITLAB_PROJECT_PATH: "group/project" used in the OIDC "sub" claim — placeholder, project-specific
GITLAB_PROJECT_PATH="group/project"
# GITLAB_PROJECT_ID: numeric project ID, only pinned in the trust policy when GITLAB_HOST is
# gitlab.com — placeholder, project-specific
GITLAB_PROJECT_ID="00000000"
# GITLAB_PROVISION_BRANCHES: space-separated branches allowed to assume the everyday
# GITLAB_ROLE_NAME role
GITLAB_PROVISION_BRANCHES="main develop"

# ===============================
# Terraform Configuration
# ===============================
# Terraform remote state & locking (S3, with S3-native locking — no DynamoDB)
# Docs: https://developer.hashicorp.com/terraform/language/settings/backends/s3
TF_VAR_tf_backend_bucket=${APP_NAME}-terraform-state-storage

# Network
TF_VAR_sk_vpc_name=${APP_NAME}_vpc
TF_VAR_sk_vpc_cidr=10.0.0.0/16
# Comma-separated, no spaces
TF_VAR_sk_subnet_cidrs=["10.0.1.0/24","10.0.2.0/24","10.0.3.0/24"]

# Instances
TF_VAR_sk_instance_type=t4g.nano
TF_VAR_sk_instance_public_ipv4=true
TF_VAR_sk_instance_ipv6_count=1

# SSH
TF_VAR_sk_ssh_key_name=${APP_NAME}_deploy_key

# ===============================
# AWS Specific
# ===============================
# AWS Regions: https://docs.aws.amazon.com/general/latest/gr/rande.html#regional-endpoints
TF_VAR_aws_region=eu-west-1

# AMI discovery (only for AWS EC2)
TF_VAR_aws_ami_name_pattern=debian-12-arm64-*
TF_VAR_aws_ami_owners=["136693071363"]
# Ubuntu (Canonical): ["099720109477"]
# Amazon Linux: ["137112412989"]
# More AMI owners: https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/finding-an-ami.html
TF_VAR_aws_ami_most_recent=true

# Optional hardcoded AMI override
# Debian 12 (arm64) HVM, SSD Volume Type, user 'admin', become 'sudo'
# TF_VAR_aws_ami_id=ami-0393eeb161ec86a1a

# phpMyAdmin options
# PMA_EXT_PORT - unique port. If you are using multiple installations, change the port value
# Use your-app-domain.com:PMA_EXT_PORT URL to access phpMyAdmin
# WARNING Do not run phpMyAdmin on production, it's not secure
PMA_EXT_PORT=8801
PMA_ARBITRARY=0

# Multi-instance (reverse proxy) mode: 0 = off (default), 1 = on. NEVER commit 1 here.
# Set per-host via a `.env.type.<env>.override` file (local) or the APP_MULTI_INSTANCE CI/CD
# variable (servers). Details: kit-modules/proxy/README.md
APP_MULTI_INSTANCE=0

# SMTP config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER and SMTP_PASS defined in .env.secret

# none|ssl|tls
SMTP_SECURE=tls
SMTP_FROM=
SMTP_NAME=

# 0 No debug output, default
# 1 Client commands
# 2 Client commands and server responses
# 3 As 2 plus connection status
# 4 Low-level data output, all messages.
SMTP_DEBUG=0
