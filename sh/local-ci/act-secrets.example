# act secrets file — TEMPLATE, placeholder names only, no real values.
#
# Copy this file to .secrets.act at the repo root (gitignored — see .gitignore) and fill in
# throwaway/test values for local `act` runs of .github/workflows/job-provision.yml:
#
#   cp sh/local-ci/act-secrets.example .secrets.act
#
# Real secret values NEVER belong in a committed file. .secrets.act stays untracked; only this
# .example file (with empty placeholders) is committed. Pass it to act via `--secret-file
# .secrets.act` (sh/local-ci/act-run.sh / the harness wires this in — do not pass secrets on the
# command line where they would land in shell history).
#
# List below matches every `secrets.X` reference in .github/workflows/job-provision.yml exactly
# (verified by grep against that file):

# SSH private key used by webfactory/ssh-agent and the "Extract SSH public key for Terraform" step.
# For local act runs, generate a throwaway keypair (the harness does this itself for the Ansible
# target — see sh/local-ci/harness-up.sh); never reuse a real deploy key here.
SSH_KEY=

# Contents written verbatim to ~/.ssh/config by the "Set up SSH config" step. A minimal throwaway
# value (or even a single comment line) is enough to satisfy the step's non-empty check locally.
SSH_CONFIG=

# Composer auth.json contents for private Composer repositories (see infrastructure.md). Only
# needed locally if the act run exercises "Install Composer and Node Dependencies" against a
# private package source; leave empty otherwise.
COMPOSER_AUTH=

# Passphrase used to GPG-encrypt/decrypt the Terraform plan artifact. Any throwaway string works
# for local act runs — it never has to match a real CI-configured value.
TFPLAN_PASSPHRASE=

# GitHub's own automatic per-run token (used only by the "Download reviewed plan artifact" step,
# actions/download-artifact@v4). act can supply this itself (e.g. `act -s GITHUB_TOKEN="$(gh auth
# token)"` or act's own default token handling) — it is listed here only because it appears as a
# `secrets.` reference in the workflow; it is not a repo-configured secret to invent a value for.
GITHUB_TOKEN=
